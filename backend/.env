# Copia este archivo a backend/.env (o exporta las variables en tu shell)
WEIGHTS_PATH=../weights/best.pt
FALLBACK_MODELS=yolo11m.pt,yolov8m.pt
IMGSZ=640
CONF_DEFAULT=0.35
IOU=0.5
DEVICE=auto            # auto | cpu | cuda:0 | mps
HALF=auto              # auto | true | false  (FP16 solo en CUDA)
SAHI_SLICE_SIZE=640
SAHI_OVERLAP=0.2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
